<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwConfigExceptions="true"
      throwExceptions="true">
      <!-- in production set throwExceptions="false" -->

      <variable name="httpLoggerFilePath" value="/var/log/at-qr-code-api-access.log" />

      <targets async="true">
            <target xsi:type="ColoredConsole" name="console" />
            <target xsi:type="File"
                  name="http-log-target"
                  layout="${aspnet-request-ip} - - [${longdate}] ${message} ${aspnet-request-useragent} "
                  fileName="${httpLoggerFilePath}" />
      </targets>

      <rules>

            <logger name="httpLogger"
                  minlevel="Trace"
                  maxlevel="Fatal"
                  enabled="true"
                  writeTo="http-log-target" />

            <logger name="*"
                  minlevel="Trace"
                  maxlevel="Fatal"
                  enabled="true"
                  writeTo="console" />

            <logger name="System.*" finalMinLevel="Warn" writeTo="console" final="true" />
            <logger name="Microsoft.*" finalMinLevel="Warn" writeTo="console" final="true" />
            <logger name="Microsoft.Hosting.Lifetime*" finalMinLevel="Info" writeTo="console"
                  final="true" />

      </rules>

</nlog>